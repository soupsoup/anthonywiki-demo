[Unit]
Description=Deploy the newest anthonywiki commit if main changed
After=network-online.target

[Service]
Type=oneshot
User=anthonywiki
Group=anthonywiki
WorkingDirectory=/var/www/anthonywiki
EnvironmentFile=-/etc/anthonywiki.env
Environment=NODE_OPTIONS=--max-old-space-size=1536
Environment=NEXT_TELEMETRY_DISABLED=1
ExecStart=/var/www/anthonywiki/deploy/vps/deploy.sh
Nice=10
CPUWeight=20
IOSchedulingClass=idle
TimeoutStartSec=20min
